---
import Base from '../layouts/Base.astro';
import { THREADS } from '../lib/threads';
---

<Base title="Not found — Hazem Abdelghany" description="That page doesn't exist." noindex>
  <section class="nf">
    <span class="kicker">404</span>
    <h1 class="nf-title">That page isn't here.</h1>
    <p class="nf-ar" dir="rtl" lang="ar">الصفحة دي مش موجودة.</p>
    <p class="nf-body">
      Either it moved or it never existed. The five threads below are where everything lives.
    </p>
    <div class="nf-links">
      {THREADS.map((t) => (
        <a href={`/threads/${t.key}/`}>
          <span dir="rtl" lang="ar">{t.ar}</span>
          <span class="tag">{t.en}</span>
        </a>
      ))}
    </div>
    <a href="/" class="meta">← Back home</a>
  </section>
</Base>

<style>
  .nf {
    display: flex; flex-direction: column; align-items: center; text-align: center;
    gap: 18px; max-width: 640px; margin: 0 auto; padding: 120px 0 100px 0;
  }
  .nf-title { font-size: clamp(32px, 4vw, 46px); font-weight: 400; }
  .nf-ar { margin: 0; font-size: 24px; color: var(--ink-2); }
  .nf-body { margin: 0; font-size: 17px; line-height: 1.7; color: var(--muted); }
  .nf-links {
    display: flex; flex-wrap: wrap; gap: 14px; justify-content: center;
    padding: 14px 0 8px 0;
  }
  .nf-links a {
    display: flex; align-items: baseline; gap: 9px;
    border: 1px solid var(--line); border-radius: 999px; padding: 8px 16px;
    font-size: 17px; color: var(--ink);
  }
  .nf-links a:hover { border-color: var(--accent); color: var(--accent); }
</style>
