---
import { publishedEssays } from '../lib/essays';
import Base from '../layouts/Base.astro';
import EssayRow from '../components/EssayRow.astro';
import { THREADS } from '../lib/threads';
import { SERIES } from '../lib/series';

const published = await publishedEssays();

// Series parts are represented by their series card, not as individual rows —
// otherwise one multi-part book occupies the entire homepage.
const essays = published.filter((e) => !e.data.series).slice(0, 4);
const seriesCards = Object.values(SERIES)
  .map((s) => ({ s, count: published.filter((e) => e.data.series === s.key).length }))
  .filter((c) => c.count > 0);

// Each thread advertises how much is actually behind it.
const threadCount = (key) => {
  const inThread = published.filter((e) => e.data.thread === key);
  const standalone = inThread.filter((e) => !e.data.series).length;
  const series = new Set(inThread.filter((e) => e.data.series).map((e) => e.data.series)).size;
  return standalone + series;
};
---

<Base>

  <section class="hero">
    <div class="hero-mark" dir="rtl" lang="ar">إزاي؟</div>
    <h1 class="hero-statement">
      This is where I <em>think out loud</em> — about building, faith, the body, and the mind.
    </h1>
    <p class="hero-ar" dir="rtl" lang="ar">هنا بفكّر بصوت عالي — بالعربي وبالإنجليزي، في كل حاجة بعيشها.</p>
    <p class="hero-bio">
      Founder at Catalyst. Muslim. Athlete mid-rebuild. Student of the mind. This site is the whole
      picture — not the highlight reel.
    </p>
    <hr class="rule" />
  </section>

  <section class="threads">
    <div class="section-head">
      <h2 class="kicker">The Five Threads</h2>
      <span dir="rtl" lang="ar" class="section-head-ar">الخيوط الخمسة</span>
    </div>
    <div class="threads-grid">
      {THREADS.map((t, i) => (
        <a class="thread" href={`/threads/${t.key}/`}>
          <span class="row-num">{String(i + 1).padStart(2, '0')}</span>
          <span class="thread-ar" dir="rtl" lang="ar">{t.ar}</span>
          <span class="tag">{t.en}</span>
          <span class="thread-blurb">{t.blurb}</span>
          <span class="thread-count">
            {threadCount(t.key) === 0 ? 'Nothing yet' : `${threadCount(t.key)} to read →`}
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="essays">
    <div class="section-head">
      <div style="display: flex; align-items: baseline; gap: 14px;">
        <h2 class="kicker">Selected Essays</h2>
        <span dir="rtl" lang="ar" class="section-head-ar">مقالات مختارة</span>
      </div>
      <a href="/essays/" class="meta">All essays →</a>
    </div>
    {seriesCards.map(({ s, count }) => (
      <a class="home-series" href={s.href}>
        <div class="home-series-top">
          <span class="tag">Series in progress</span>
          <span class="meta">{count} {count === 1 ? 'part' : 'parts'}</span>
        </div>
        <h3 class="home-series-title">{s.title}</h3>
        <p class="home-series-sub">{s.subtitle}</p>
      </a>
    ))}
    <div class="row-list">
      {essays.map((e, i) => <EssayRow essay={e} num={String(i + 1).padStart(2, '0')} />)}
    </div>
  </section>

  <section class="about">
    <div class="about-head">
      <span class="about-ar" dir="rtl" lang="ar">عنّي</span>
      <h2 class="kicker">About</h2>
    </div>
    <div class="about-body">
      <p>
        I'm Hazem — from Cairo. I run <em>Catalyst</em>, an AI and software company, and co-build
        <em>Mental Diet</em> with a psychiatrist. I code everything with agentic AI, train around a
        rebuilt ACL, memorize Qur'an on Mondays, and keep my whole life in one system. The essays
        here are how I think — drafted with AI, but the thinking is mine.
      </p>
      <a href="/about/" class="meta">More about me →</a>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 26px;
    text-align: center;
    max-width: 920px;
    margin: 0 auto;
    padding: 110px 0 100px 0;
  }
  .hero-mark { font-size: 22px; color: var(--accent); }
  .hero-statement {
    font-size: clamp(34px, 4.2vw, 52px);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.5px;
  }
  .hero-statement em { color: var(--accent); }
  .hero-ar { margin: 0; font-size: clamp(22px, 2.4vw, 28px); line-height: 1.8; color: var(--ink-2); }
  .hero-bio { margin: 0; font-size: 16px; line-height: 1.6; color: var(--muted); max-width: 640px; }

  section.threads, section.essays, section.about {
    border-top: 1px solid var(--line);
    padding: 64px 0 72px 0;
  }
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 34px;
  }
  .section-head-ar { font-size: 17px; color: var(--muted); }

  .threads-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 36px;
  }
  .thread { display: flex; flex-direction: column; gap: 12px; }
  .thread .thread-ar, .thread .thread-blurb { transition: color 0.18s ease; }
  .thread:hover .thread-ar { color: var(--accent); }
  .thread-count {
    font-size: 11px; font-weight: 500; letter-spacing: 1.6px;
    text-transform: uppercase; color: var(--faint); margin-top: 2px;
  }
  .thread:hover .thread-count { color: var(--accent); }
  .thread-ar { font-weight: 700; font-size: 30px; color: var(--ink); align-self: start; }
  .thread-blurb { font-size: 15px; font-style: italic; line-height: 1.55; color: var(--muted); }

  .home-series {
    display: block; border: 1px solid var(--line); background: var(--fig-surface);
    padding: 24px 26px; margin-bottom: 26px;
  }
  .home-series:hover { border-color: var(--accent); }
  .home-series-top { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 10px; }
  .home-series-title { font-size: 25px; font-weight: 500; color: var(--ink); }
  .home-series:hover .home-series-title { color: var(--accent); }
  .home-series-sub { margin: 6px 0 0 0; font-size: 15px; font-style: italic; color: var(--muted); }

  .about { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 64px; }
  .about-head { display: flex; flex-direction: column; gap: 10px; }
  .about-ar { font-weight: 700; font-size: 34px; }
  .about-body { display: flex; flex-direction: column; gap: 20px; }
  .about-body p { margin: 0; font-size: 20px; line-height: 1.65; }

  @media (max-width: 900px) {
    .hero { padding: 72px 0 64px 0; }
    .threads-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .about { grid-template-columns: 1fr; gap: 24px; }
  }
  @media (max-width: 560px) {
    .threads-grid { grid-template-columns: 1fr; }
  }
</style>
