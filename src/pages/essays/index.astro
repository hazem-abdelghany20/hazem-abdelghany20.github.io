---
import { publishedEssays } from '../../lib/essays';
import Base from '../../layouts/Base.astro';
import EssayRow from '../../components/EssayRow.astro';
import { SERIES, seriesHref } from '../../lib/series';

const all = await publishedEssays();

// This page is articles only — one-off pieces that stand on their own.
// Book parts are not listed here; a book is a different kind of thing and
// lives at /books/, otherwise nineteen parts of one book bury everything else.
const standalone = all.filter((e) => !e.data.series);
const books = Object.values(SERIES)
  .map((s) => ({ s, count: all.filter((e) => e.data.series === s.key && e.data.lang === 'en').length }))
  .filter((b) => b.count > 0);
---

<Base
  title="Articles · مقالات — Hazem Abdelghany"
  description="Standalone articles by Hazem Abdelghany, across five threads — building, faith, the body, the mind, and perspective. In Egyptian Arabic and English. The long-form books live separately."
>

  <header class="page-head">
    <h1 class="page-title">Articles</h1>
    <span dir="rtl" lang="ar" class="page-title-ar">مقالات</span>
  </header>

  <p class="page-lede">
    One-off pieces, each one standing on its own. The long-form work is in the
    <a href="/books/">books</a>.
  </p>

  <div class="row-list">
    {standalone.map((e, i) => <EssayRow essay={e} num={String(i + 1).padStart(2, '0')} />)}
  </div>

  {books.length > 0 && (
    <section class="also-books">
      <div class="section-head">
        <h2 class="kicker">Also — the books</h2>
        <span dir="rtl" lang="ar" class="section-head-ar">الكتب</span>
      </div>
      {books.map(({ s, count }) => (
        <a class="series-card" href={seriesHref(s.key)}>
          <div class="series-card-top">
            <span class="tag">Book</span>
            <span class="meta">{count} of {s.parts} parts</span>
          </div>
          <h3 class="series-card-title">{s.title}</h3>
          <p class="series-card-sub">{s.subtitle}</p>
          <span class="series-card-cta">Start reading →</span>
        </a>
      ))}
    </section>
  )}
</Base>

<style>
  .page-head {
    display: flex;
    align-items: baseline;
    gap: 20px;
    padding: 88px 0 20px 0;
  }
  .page-title { font-size: 44px; font-weight: 400; }
  .page-title-ar { font-size: 34px; font-weight: 700; color: var(--muted); }
  .page-lede {
    max-width: 62ch; margin: 0 0 40px 0;
    font-size: 17px; line-height: 1.7; color: var(--muted);
  }
  .page-lede a { color: var(--accent); }

  .also-books { border-top: 1px solid var(--line); margin-top: 72px; padding: 56px 0 0 0; }
  .section-head { display: flex; justify-content: space-between; align-items: baseline; padding-bottom: 30px; }
  .section-head-ar { font-size: 17px; color: var(--muted); }

  .series-card {
    display: block;
    border: 1px solid var(--line);
    padding: 30px 32px 28px 32px;
    margin-bottom: 40px;
    background: var(--fig-surface);
  }
  .series-card:hover { border-color: var(--accent); }
  .series-card-top { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 14px; }
  .series-card-title { font-size: 32px; font-weight: 500; color: var(--ink); line-height: 1.15; }
  .series-card:hover .series-card-title { color: var(--accent); }
  .series-card-sub { margin: 8px 0 0 0; font-size: 15px; font-style: italic; color: var(--muted); }
  .series-card-blurb { margin: 16px 0 0 0; font-size: 16px; line-height: 1.6; color: var(--ink-2); max-width: 62ch; }
  .series-card-cta {
    display: inline-block; margin-top: 20px;
    font-size: 11px; font-weight: 500; letter-spacing: 1.8px; text-transform: uppercase; color: var(--accent);
  }
</style>
