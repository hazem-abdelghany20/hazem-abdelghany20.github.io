---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import EssayRow from '../../components/EssayRow.astro';

const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<Base title="Essays · مقالات — Hazem Abdelghany">
  <Nav />

  <header class="page-head">
    <h1 class="page-title">Essays</h1>
    <span dir="rtl" lang="ar" class="page-title-ar">مقالات</span>
  </header>

  <div class="row-list">
    {essays.map((e, i) => <EssayRow essay={e} num={String(i + 1).padStart(2, '0')} />)}
  </div>

  <Footer />
</Base>

<style>
  .page-head {
    display: flex;
    align-items: baseline;
    gap: 20px;
    padding: 88px 0 44px 0;
  }
  .page-title { font-size: 44px; font-weight: 400; }
  .page-title-ar { font-size: 34px; font-weight: 700; color: var(--muted); }
</style>
