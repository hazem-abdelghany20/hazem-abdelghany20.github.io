---
import { publishedEssays } from '../../lib/essays';
import Base from '../../layouts/Base.astro';
import EssayRow from '../../components/EssayRow.astro';
import { SERIES, seriesHref } from '../../lib/series';

const all = await publishedEssays();

// A series collapses to a single row. Otherwise nineteen parts of one book
// bury everything else on the page.
const standalone = all.filter((e) => !e.data.series);
const seriesCards = Object.values(SERIES)
  .map((s) => {
    const parts = all.filter((e) => e.data.series === s.key);
    return { s, count: parts.length, latest: parts[0]?.data.date };
  })
  .filter((c) => c.count > 0);
---

<Base
  title="Essays · مقالات — Hazem Abdelghany"
  description="Everything Hazem Abdelghany has published, across five threads — building, faith, the body, the mind, and perspective. In Egyptian Arabic and English."
>

  <header class="page-head">
    <h1 class="page-title">Essays</h1>
    <span dir="rtl" lang="ar" class="page-title-ar">مقالات</span>
  </header>

  {seriesCards.map(({ s, count }) => (
    <a class="series-card" href={seriesHref(s.key)}>
      <div class="series-card-top">
        <span class="tag">Series</span>
        <span class="meta">{count} {count === 1 ? 'part' : 'parts'}</span>
      </div>
      <h2 class="series-card-title">{s.title}</h2>
      <p class="series-card-sub">{s.subtitle}</p>
      <p class="series-card-blurb">{s.blurb}</p>
      <span class="series-card-cta">Start reading →</span>
    </a>
  ))}

  <div class="row-list">
    {standalone.map((e, i) => <EssayRow essay={e} num={String(i + 1).padStart(2, '0')} />)}
  </div>
</Base>

<style>
  .page-head {
    display: flex;
    align-items: baseline;
    gap: 20px;
    padding: 88px 0 44px 0;
  }
  .page-title { font-size: 44px; font-weight: 400; }
  .page-title-ar { font-size: 34px; font-weight: 700; color: var(--muted); }

  .series-card {
    display: block;
    border: 1px solid var(--line);
    padding: 30px 32px 28px 32px;
    margin-bottom: 40px;
    background: var(--fig-surface);
  }
  .series-card:hover { border-color: var(--accent); }
  .series-card-top { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 14px; }
  .series-card-title { font-size: 32px; font-weight: 500; color: var(--ink); line-height: 1.15; }
  .series-card:hover .series-card-title { color: var(--accent); }
  .series-card-sub { margin: 8px 0 0 0; font-size: 15px; font-style: italic; color: var(--muted); }
  .series-card-blurb { margin: 16px 0 0 0; font-size: 16px; line-height: 1.6; color: var(--ink-2); max-width: 62ch; }
  .series-card-cta {
    display: inline-block; margin-top: 20px;
    font-size: 11px; font-weight: 500; letter-spacing: 1.8px; text-transform: uppercase; color: var(--accent);
  }
</style>
