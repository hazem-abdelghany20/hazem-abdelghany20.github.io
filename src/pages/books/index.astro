---
import { publishedEssays } from '../../lib/essays';
import Base from '../../layouts/Base.astro';
import { SERIES, seriesHref } from '../../lib/series';

const all = await publishedEssays();

// A book is a series with at least one published part. Long-form lives here;
// one-off pieces live at /essays/. Keeping them on separate pages is the point:
// a nineteen-part book and a single essay are not the same kind of thing.
const books = Object.values(SERIES)
  .map((s) => ({ s, count: all.filter((e) => e.data.series === s.key && e.data.lang === 'en').length }))
  .filter((b) => b.count > 0);
---

<Base
  title="Books · كتب — Hazem Abdelghany"
  description="The long-form work: The Conditions of Fortune and The Effort Is Yours, published in parts in English and Arabic."
>

  <header class="page-head">
    <h1 class="page-title">Books</h1>
    <span dir="rtl" lang="ar" class="page-title-ar">كتب</span>
  </header>

  <p class="page-lede">
    Long-form work, written in parts and published as each part is finished. Shorter one-off pieces
    are under <a href="/essays/">articles</a>.
  </p>

  {books.map(({ s, count }) => (
    <a class="book-card" href={seriesHref(s.key)}>
      <img class="book-card-cover" src={s.cover} alt={`Cover of ${s.title}`} width="800" height="1200" />
      <div class="book-card-copy">
        <div class="book-card-top">
          <div>
            <span class="tag">{s.category}</span>
            <span class="book-card-category-ar" dir="rtl" lang="ar">{s.categoryAr}</span>
          </div>
          <span class="meta">{count} of {s.parts} parts</span>
        </div>
        <h2 class="book-card-title">{s.title}</h2>
        <p class="book-card-ar" dir="rtl" lang="ar">{s.ar}</p>
        <p class="book-card-sub">{s.subtitle}</p>
        <p class="book-card-blurb">{s.blurb}</p>
        <span class="book-card-cta">Start reading →</span>
      </div>
    </a>
  ))}
</Base>

<style>
  .page-head {
    display: flex;
    align-items: baseline;
    gap: 20px;
    padding: 88px 0 20px 0;
  }
  .page-title { font-size: 44px; font-weight: 400; }
  .page-title-ar { font-size: 34px; font-weight: 700; color: var(--muted); }
  .page-lede {
    max-width: 62ch;
    margin: 0 0 44px 0;
    font-size: 17px;
    line-height: 1.7;
    color: var(--muted);
  }
  .page-lede a { color: var(--accent); }

  .book-card {
    display: grid;
    grid-template-columns: minmax(190px, 280px) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 58px);
    align-items: center;
    border-top: 1px solid var(--line);
    padding: 46px 0;
    color: var(--ink);
  }
  .book-card:last-child { border-bottom: 1px solid var(--line); }
  .book-card-cover {
    width: 100%; height: auto; aspect-ratio: 2 / 3; object-fit: cover; display: block;
    border: 1px solid var(--line); box-shadow: 0 18px 38px rgba(38,34,27,.12);
    transition: transform .35s ease, filter .8s ease, box-shadow .35s ease;
  }
  :global(:root[data-theme='dark']) .book-card-cover {
    filter: brightness(.72) saturate(.84) contrast(1.05);
    box-shadow: 0 20px 44px rgba(0,0,0,.38);
  }
  .book-card:hover .book-card-cover { transform: translateY(-5px); }
  .book-card-copy { max-width: 650px; }
  .book-card-top { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; margin-bottom: 14px; }
  .book-card-top > div { display: flex; flex-direction: column; gap: 3px; }
  .book-card-category-ar { font-size: 15px; color: var(--muted); }
  .book-card-ar { margin: 7px 0 0; font-size: 24px; font-weight: 700; color: var(--accent); }
  .book-card-title { font-size: clamp(34px, 4.6vw, 52px); font-weight: 500; color: var(--ink); line-height: 1.03; }
  .book-card:hover .book-card-title { color: var(--accent); }
  .book-card-sub { margin: 8px 0 0 0; font-size: 15px; font-style: italic; color: var(--muted); }
  .book-card-blurb { margin: 16px 0 0 0; font-size: 16px; line-height: 1.6; color: var(--ink-2); max-width: 62ch; }
  .book-card-cta {
    display: inline-block; margin-top: 20px;
    font-size: 11px; font-weight: 500; letter-spacing: 1.8px; text-transform: uppercase; color: var(--accent);
  }

  @media (max-width: 680px) {
    .book-card { grid-template-columns: 120px minmax(0, 1fr); gap: 20px; align-items: start; }
    .book-card-top { flex-direction: column; gap: 7px; }
    .book-card-title { font-size: 28px; }
    .book-card-ar { font-size: 20px; }
    .book-card-blurb { display: none; }
  }
</style>
