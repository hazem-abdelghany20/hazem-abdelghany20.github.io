---
import { publishedEssays } from '../../lib/essays';
import Base from '../../layouts/Base.astro';
import EssayRow from '../../components/EssayRow.astro';
import { THREADS, threadLabel } from '../../lib/threads';
import { SERIES, seriesHref } from '../../lib/series';

export async function getStaticPaths() {
  return THREADS.map((t) => ({ params: { thread: t.key } }));
}

const { thread } = Astro.params;
const t = threadLabel(thread as any);

const all = (await publishedEssays()).filter((e) => e.data.thread === thread);

// A series shows as one card, exactly as it does on the essays index —
// otherwise a nineteen-part book is the entire thread page.
const standalone = all.filter((e) => !e.data.series);
const seriesHere = Object.values(SERIES)
  .map((s) => ({ s, count: all.filter((e) => e.data.series === s.key).length }))
  .filter((c) => c.count > 0);

const others = THREADS.filter((x) => x.key !== thread);
const total = standalone.length + seriesHere.length;
---

<Base
  title={`${t.en} · ${t.ar} — Hazem Abdelghany`}
  description={`${t.blurb} Essays by Hazem Abdelghany on ${t.en.toLowerCase()}.`}
>

  <header class="thread-head">
    <a href="/essays/" class="back">← All essays</a>
    <div class="thread-title-row">
      <h1 class="thread-title">{t.en}</h1>
      <span dir="rtl" lang="ar" class="thread-title-ar">{t.ar}</span>
    </div>
    <p class="thread-blurb">{t.blurb}</p>
  </header>

  {total === 0 ? (
    <p class="thread-empty">
      Nothing published under this thread yet. It's one of the five I write across — it just hasn't
      had its turn.
    </p>
  ) : (
    <div class="thread-body">
      {seriesHere.map(({ s, count }) => (
        <a class="thread-series" href={seriesHref(s.key)}>
          <div class="thread-series-top">
            <span class="tag">Series</span>
            <span class="meta">{count} {count === 1 ? 'part' : 'parts'}</span>
          </div>
          <h2 class="thread-series-title">{s.title}</h2>
          <p class="thread-series-sub">{s.subtitle}</p>
        </a>
      ))}
      <div class="row-list">
        {standalone.map((e, i) => <EssayRow essay={e} num={String(i + 1).padStart(2, '0')} />)}
      </div>
    </div>
  )}

  <section class="thread-others">
    <div class="section-head">
      <h2 class="kicker">The other threads</h2>
      <span dir="rtl" lang="ar" class="section-head-ar">الخيوط التانية</span>
    </div>
    <div class="thread-others-grid">
      {others.map((o) => (
        <a class="thread-chip" href={`/threads/${o.key}/`}>
          <span class="thread-chip-ar" dir="rtl" lang="ar">{o.ar}</span>
          <span class="tag">{o.en}</span>
          <span class="thread-chip-blurb">{o.blurb}</span>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .thread-head { padding: 65px 0 36px 0; max-width: 680px; }
  .back {
    font-size: 11px; font-weight: 500; letter-spacing: 1.8px;
    text-transform: uppercase; color: var(--muted);
  }
  .back:hover { color: var(--accent); }
  .thread-title-row { display: flex; align-items: baseline; gap: 18px; margin-top: 10px; flex-wrap: wrap; }
  .thread-title { font-size: clamp(36px, 5vw, 52px); font-weight: 400; }
  .thread-title-ar { font-size: clamp(28px, 3.6vw, 38px); font-weight: 700; color: var(--accent); }
  .thread-blurb { margin: 14px 0 0 0; font-size: 19px; line-height: 1.6; color: var(--ink-2); }
  .thread-empty {
    max-width: 680px; font-size: 17px; line-height: 1.7;
    color: var(--muted); font-style: italic; padding: 8px 0 20px 0;
  }

  .thread-series {
    display: block; border: 1px solid var(--line);
    background: var(--fig-surface); padding: 26px 28px; margin-bottom: 28px;
  }
  .thread-series:hover { border-color: var(--accent); }
  .thread-series-top { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 12px; }
  .thread-series-title { font-size: 27px; font-weight: 500; color: var(--ink); }
  .thread-series:hover .thread-series-title { color: var(--accent); }
  .thread-series-sub { margin: 6px 0 0 0; font-size: 15px; font-style: italic; color: var(--muted); }

  .thread-others { border-top: 1px solid var(--line); margin-top: 72px; padding: 56px 0 0 0; }
  .section-head { display: flex; justify-content: space-between; align-items: baseline; padding-bottom: 30px; }
  .section-head-ar { font-size: 17px; color: var(--muted); }
  .thread-others-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 30px; }
  .thread-chip { display: flex; flex-direction: column; gap: 10px; }
  .thread-chip-ar { font-weight: 700; font-size: 26px; color: var(--ink); align-self: start; }
  .thread-chip:hover .thread-chip-ar { color: var(--accent); }
  .thread-chip-blurb { font-size: 14px; font-style: italic; line-height: 1.5; color: var(--muted); }

  @media (max-width: 900px) { .thread-others-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .thread-others-grid { grid-template-columns: 1fr; } }
</style>
