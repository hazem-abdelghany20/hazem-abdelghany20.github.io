---
import Base from '../layouts/Base.astro';
import BookPartsList from '../components/BookPartsList.astro';
import { SERIES, seriesHref, type SeriesKey } from '../lib/series';
import { publishedEssays } from '../lib/essays';

export async function getStaticPaths() {
  return Object.values(SERIES).map((s) => ({ params: { series: s.slug }, props: { key: s.key } }));
}

const { key } = Astro.props as { key: SeriesKey };
const s = SERIES[key];
const all = await publishedEssays();
const inSeries = (lang: 'en' | 'ar') =>
  all
    .filter((e) => e.data.series === key && e.data.lang === lang)
    .sort((a, b) => (a.data.part ?? 0) - (b.data.part ?? 0));

// The book exists twice. The English list is the default; the Arabic edition
// is the same book, so it lives on the same page behind a toggle rather than
// at a second URL.
const parts = inSeries('en');
const partsAr = inSeries('ar');
const md = (t: string) => t.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
---

<Base title={`${s.title} — Hazem Abdelghany`} description={s.blurb}>
  <header class="bw-head">
    <img class="bw-cover" src={s.cover} alt={`Cover of ${s.title}`} width="800" height="1200" fetchpriority="high" />
    <div class="bw-head-copy">
      <div class="bw-category">
        <span class="kicker">{s.category}</span>
        <span dir="rtl" lang="ar">{s.categoryAr}</span>
      </div>
      <h1 class="bw-title">
        {s.titleParts[0]} <span class="amp">{s.titleParts[1]}</span> {s.titleParts[2]}
      </h1>
      <p class="bw-title-ar" dir="rtl" lang="ar">{s.ar}</p>
      <p class="bw-subtitle">{s.subtitle}</p>
      <p class="bw-lede">{s.blurb}</p>
      <div class="bw-meta">
        {s.facts.map((f) => <span>{f}</span>)}
        <span>{parts.length} of {s.parts} published</span>
        {partsAr.length > 0 && <span dir="rtl" lang="ar">متوفر بالعربي</span>}
      </div>
    </div>
  </header>

  <section class="bw-front">
    {s.note && (
      <div class="bw-note">
        <span class="kicker">{s.note.label}</span>
        {s.note.body.map((p) => <p set:html={md(p)} />)}
      </div>
    )}
    {s.front.map((block) => (
      <>
        <h2>{block.heading}</h2>
        {block.body.map((p) => <p set:html={md(p)} />)}
      </>
    ))}
  </section>

  <section class="bw-toc">
    <div class="section-head">
      <h2 class="kicker">The parts</h2>
      {partsAr.length > 0 ? (
        <div class="lang-switch" role="group" aria-label="Edition">
          <button type="button" class="lang-btn is-on" data-lang="en">English</button>
          <button type="button" class="lang-btn" data-lang="ar" dir="rtl" lang="ar">بالعربي</button>
        </div>
      ) : (
        <span class="meta">{parts.length} {parts.length === 1 ? 'part' : 'parts'}</span>
      )}
    </div>
    {parts.length === 0 ? (
      <p class="bw-empty">The first part goes up shortly.</p>
    ) : (
      <BookPartsList parts={parts} sections={s.sections} lang="en" />
    )}
    {partsAr.length > 0 && (
      <BookPartsList parts={partsAr} sections={s.sections} lang="ar" hidden />
    )}
  </section>

  <script is:inline>
    (function () {
      var btns = document.querySelectorAll('.lang-btn');
      if (!btns.length) return;
      btns.forEach(function (b) {
        b.addEventListener('click', function () {
          var lang = b.getAttribute('data-lang');
          btns.forEach(function (x) { x.classList.toggle('is-on', x === b); });
          document.querySelectorAll('[data-list]').forEach(function (l) {
            l.hidden = l.getAttribute('data-list') !== lang;
          });
        });
      });
    })();
  </script>

  <nav class="bw-other">
    {Object.values(SERIES)
      .filter((o) => o.key !== key)
      .map((o) => (
        <a class="bw-other-link" href={seriesHref(o.key)}>
          <span class="kicker">The other series</span>
          <span class="bw-other-title">{o.title}</span>
          <span class="bw-other-sub">{o.subtitle}</span>
        </a>
      ))}
  </nav>
</Base>

<style>
  .bw-head {
    max-width: 980px; margin: 0 auto; padding: 80px 0 72px;
    display: grid; grid-template-columns: minmax(210px, 320px) minmax(0, 1fr);
    align-items: center; gap: clamp(42px, 7vw, 84px);
  }
  .bw-cover {
    width: 100%; height: auto; aspect-ratio: 2 / 3; object-fit: cover; display: block;
    border: 1px solid var(--line); box-shadow: 0 24px 54px rgba(38,34,27,.14);
    transition: filter .8s ease, box-shadow .8s ease;
  }
  :global(:root[data-theme='dark']) .bw-cover {
    filter: brightness(.72) saturate(.84) contrast(1.05);
    box-shadow: 0 26px 60px rgba(0,0,0,.42);
  }
  .bw-head-copy { display: flex; flex-direction: column; align-items: flex-start; gap: 17px; }
  .bw-category { display: flex; align-items: baseline; gap: 14px; color: var(--muted); }
  .bw-category [lang='ar'] { font-size: 15px; }
  .bw-title { font-size: clamp(46px, 6.2vw, 76px); line-height: .98; font-weight: 500; letter-spacing: -0.025em; }
  .bw-title .amp { font-style: italic; color: var(--accent); }
  .bw-title-ar { margin: -4px 0 0; color: var(--accent); font-size: clamp(26px, 3vw, 36px); }
  .bw-subtitle { margin: 0; color: var(--muted); font-size: 17px; line-height: 1.5; font-style: italic; max-width: 46ch; }
  .bw-lede { font-size: 18px; line-height: 1.6; color: var(--ink-2); max-width: 54ch; margin: 3px 0 0; }
  .bw-meta {
    display: flex; flex-wrap: wrap; gap: 8px 22px; justify-content: flex-start;
    font-size: 11px; font-weight: 500; letter-spacing: 1.8px; text-transform: uppercase;
    color: var(--muted); border-top: 1px solid var(--line); padding-top: 18px; margin-top: 6px;
  }

  .bw-front { max-width: 680px; margin: 0 auto; }
  .bw-front h2 { font-size: 25px; font-weight: 500; margin: 44px 0 14px 0; }
  .bw-front p { margin: 0 0 18px 0; color: var(--ink-2); line-height: 1.72; }
  .bw-note { border-left: 2px solid var(--accent); padding: 4px 0 4px 22px; margin-bottom: 8px; }
  .bw-note .kicker { display: block; margin-bottom: 12px; }

  .bw-toc { max-width: 680px; margin: 76px auto 0 auto; }
  .section-head {
    display: flex; justify-content: space-between; align-items: baseline;
    padding-bottom: 14px; border-bottom: 1px solid var(--line);
  }
  .bw-list { list-style: none; margin: 0; padding: 0; }
  .bw-list li { border-bottom: 1px solid var(--line); }
  .bw-list a { display: grid; gap: 5px; padding: 20px 0; }
  .bw-part { font-size: 11px; font-weight: 500; letter-spacing: 1.8px; text-transform: uppercase; color: var(--muted); }
  .bw-list a:hover .bw-part { color: var(--accent); }
  .bw-part-title { font-size: 21px; color: var(--ink); line-height: 1.3; }
  .bw-list a:hover .bw-part-title { color: var(--accent); }
  .bw-part-desc { font-size: 15px; color: var(--muted); line-height: 1.5; }
  .bw-empty { color: var(--muted); font-style: italic; padding-top: 20px; }

  .bw-other { max-width: 680px; margin: 72px auto 0 auto; }
  .bw-other-link {
    display: grid; gap: 6px; border: 1px solid var(--line);
    background: var(--fig-surface); padding: 24px 26px;
  }
  .bw-other-link:hover { border-color: var(--accent); }
  .bw-other-title { font-size: 25px; font-weight: 500; color: var(--ink); }
  .bw-other-link:hover .bw-other-title { color: var(--accent); }
  .bw-other-sub { font-size: 15px; font-style: italic; color: var(--muted); }

  @media (max-width: 760px) {
    .bw-head { grid-template-columns: 118px minmax(0, 1fr); gap: 22px; align-items: start; padding: 56px 0 48px; }
    .bw-head-copy { gap: 11px; }
    .bw-title { font-size: clamp(32px, 9.5vw, 48px); }
    .bw-title-ar { font-size: 22px; }
    .bw-lede { grid-column: 1 / -1; }
    .bw-meta { display: none; }
  }
</style>
