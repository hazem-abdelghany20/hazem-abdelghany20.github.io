---
import type { CollectionEntry } from 'astro:content';
import type { SeriesSection } from '../lib/series';

type Essay = CollectionEntry<'essays'>;

interface Props {
  parts: Essay[];
  sections?: SeriesSection[];
  lang: 'en' | 'ar';
  hidden?: boolean;
}

const { parts, sections = [], lang, hidden = false } = Astro.props;
const isArabic = lang === 'ar';
const hasSections = sections.length > 0;
const firstSectionPart = sections[0]?.startPart ?? Number.POSITIVE_INFINITY;
const lastSectionPart = sections.at(-1)?.endPart ?? Number.NEGATIVE_INFINITY;
const opening = hasSections
  ? parts.filter((part) => (part.data.part ?? 0) < firstSectionPart)
  : parts;
const closing = hasSections
  ? parts.filter((part) => (part.data.part ?? 0) > lastSectionPart)
  : [];
const divisions = sections.map((section) => ({
  section,
  parts: parts.filter((part) => {
    const number = part.data.part ?? 0;
    return number >= section.startPart && number <= section.endPart;
  }),
}));
---

<div
  class:list={['book-parts', { 'book-parts-ar': isArabic }]}
  data-list={lang}
  dir={isArabic ? 'rtl' : 'ltr'}
  lang={lang}
  hidden={hidden}
>
  {opening.length > 0 && (
    <ol class="bw-list bw-list-edge">
      {opening.map((part) => (
        <li>
          <a href={`/essays/${part.id}/`}>
            <span class="bw-part">{part.data.partLabel}</span>
            <span class="bw-part-title">{part.data.title}</span>
            <span class="bw-part-desc">{part.data.description}</span>
          </a>
        </li>
      ))}
    </ol>
  )}

  {divisions.map(({ section, parts: sectionParts }) => (
      <section class="book-division" aria-labelledby={`division-${lang}-${section.number}`}>
        <img
          class="book-division-image"
          src={section.image}
          alt={section.alt}
          width="1536"
          height="1024"
          loading="lazy"
          decoding="async"
        />
        <header class="book-division-copy">
          <span class="book-division-number">{isArabic ? `الجزء ${section.numberAr}` : `Part ${section.number}`}</span>
          <h3 id={`division-${lang}-${section.number}`}>
            {isArabic ? section.titleAr : section.title}
          </h3>
          <p>{isArabic ? section.subtitleAr : section.subtitle}</p>
        </header>
        <ol class="bw-list">
          {sectionParts.map((part) => (
            <li>
              <a href={`/essays/${part.id}/`}>
                <span class="bw-part">{part.data.partLabel}</span>
                <span class="bw-part-title">{part.data.title}</span>
                <span class="bw-part-desc">{part.data.description}</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
  ))}

  {closing.length > 0 && (
    <ol class="bw-list bw-list-edge bw-list-closing">
      {closing.map((part) => (
        <li>
          <a href={`/essays/${part.id}/`}>
            <span class="bw-part">{part.data.partLabel}</span>
            <span class="bw-part-title">{part.data.title}</span>
            <span class="bw-part-desc">{part.data.description}</span>
          </a>
        </li>
      ))}
    </ol>
  )}
</div>

<style>
  .book-parts[hidden] { display: none; }
  .bw-list { list-style: none; margin: 0; padding: 0; }
  .bw-list li { border-bottom: 1px solid var(--line); }
  .bw-list a { display: grid; gap: 5px; padding: 20px 0; }
  .bw-part {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: var(--muted);
  }
  .bw-list a:hover .bw-part { color: var(--accent); }
  .bw-part-title { font-size: 21px; color: var(--ink); line-height: 1.3; }
  .bw-list a:hover .bw-part-title { color: var(--accent); }
  .bw-part-desc { font-size: 15px; color: var(--muted); line-height: 1.5; }
  .book-division { margin-top: 64px; }
  .book-division-image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border: 1px solid var(--line);
    background: var(--fig-surface);
    box-shadow: 0 18px 42px rgba(38, 34, 27, 0.11);
    transition: filter 0.8s ease, box-shadow 0.8s ease;
  }
  :global(:root[data-theme='dark']) .book-division-image {
    filter: brightness(0.72) saturate(0.8) contrast(1.08);
    box-shadow: 0 20px 46px rgba(0, 0, 0, 0.34);
  }
  .book-division-copy {
    display: grid;
    grid-template-columns: 84px minmax(0, 1fr);
    column-gap: 18px;
    row-gap: 4px;
    padding: 18px 0 16px;
    border-bottom: 1px solid var(--line);
  }
  .book-division-number {
    grid-row: 1 / span 2;
    padding-top: 4px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--accent);
  }
  .book-division-copy h3 {
    margin: 0;
    color: var(--ink);
    font-size: clamp(25px, 4vw, 34px);
    font-weight: 500;
    line-height: 1.15;
  }
  .book-division-copy p {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.45;
    font-style: italic;
  }
  .bw-list-edge { margin-top: 0; }
  .bw-list-closing { margin-top: 64px; border-top: 1px solid var(--line); }
  .book-parts-ar .book-division-copy {
    grid-template-columns: minmax(0, 1fr) 84px;
  }
  .book-parts-ar .book-division-number {
    grid-column: 2;
  }
  .book-parts-ar .book-division-copy h3,
  .book-parts-ar .book-division-copy p {
    grid-column: 1;
  }
  .book-parts-ar .book-division-copy h3 { font-size: clamp(27px, 4vw, 36px); }
  .book-parts-ar .book-division-copy p { font-style: normal; font-size: 16px; }

  @media (max-width: 560px) {
    .book-division { margin-top: 48px; }
    .book-division-copy,
    .book-parts-ar .book-division-copy {
      grid-template-columns: 1fr;
      gap: 5px;
      padding-top: 14px;
    }
    .book-division-number,
    .book-parts-ar .book-division-number {
      grid-column: 1;
      grid-row: auto;
      padding-top: 0;
    }
    .book-parts-ar .book-division-copy h3,
    .book-parts-ar .book-division-copy p { grid-column: 1; }
  }
</style>
