---
interface Props { lang?: 'en' | 'ar' }
const { lang = 'en' } = Astro.props;
const isAr = lang === 'ar';
---
<nav class="nav">
  <a href="/" class="nav-name">
    <span class="ar" dir="rtl" lang="ar">حازم عبدالغني</span>
    <span class="dot">·</span>
    <span class="en">HAZEM ABDELGHANY</span>
  </a>
  <div class="nav-links">
    {isAr ? (
      <>
        <a href="/books/">كتب <span class="en" dir="ltr" lang="en">Books</span></a>
        <a href="/essays/">مقالات <span class="en" dir="ltr" lang="en">Articles</span></a>
        <a href="/ar/about/">عنّي <span class="en" dir="ltr" lang="en">About</span></a>
      </>
    ) : (
      <>
        <a href="/books/">Books <span class="ar" dir="rtl" lang="ar">كتب</span></a>
        <a href="/essays/">Articles <span class="ar" dir="rtl" lang="ar">مقالات</span></a>
        <a href="/about/">About <span class="ar" dir="rtl" lang="ar">عنّي</span></a>
      </>
    )}
    <button
      class="theme-toggle"
      id="theme-toggle"
      aria-label={isAr ? 'استخدم الوضع الداكن' : 'Switch to dark mode'}
      aria-pressed="false"
      data-label-dark={isAr ? 'استخدم الوضع الداكن' : 'Switch to dark mode'}
      data-label-light={isAr ? 'استخدم الوضع الفاتح' : 'Switch to light mode'}
    >
      <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
      </svg>
      <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
      </svg>
    </button>
  </div>
</nav>

<script is:inline>
  var themeToggle = document.getElementById('theme-toggle');
  function syncThemeToggle() {
    var isDark = document.documentElement.dataset.theme === 'dark';
    themeToggle.setAttribute('aria-pressed', String(isDark));
    themeToggle.setAttribute('aria-label', themeToggle.dataset[isDark ? 'labelLight' : 'labelDark']);
  }
  syncThemeToggle();
  themeToggle.addEventListener('click', function () {
    var next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch (e) {}
    syncThemeToggle();
  });
</script>
