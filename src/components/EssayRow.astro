---
import type { CollectionEntry } from 'astro:content';
import { threadLabel, formatDate } from '../lib/threads';

interface Props {
  essay: CollectionEntry<'essays'>;
  num?: string;
}
const { essay, num } = Astro.props;
const isAr = essay.data.lang === 'ar';
const thread = threadLabel(essay.data.thread);
---

<a class="row" href={`/essays/${essay.id}/`} dir={isAr ? 'rtl' : 'ltr'}>
  <div class="row-left">
    {num && <span class="row-num">{num}</span>}
    <span class="row-title" lang={isAr ? 'ar' : 'en'}>{essay.data.title}</span>
  </div>
  <div class="row-right">
    <span class="tag">{essay.data.partLabel ?? thread.en}</span>
    <span class="meta">{formatDate(essay.data.date)}</span>
  </div>
</a>
