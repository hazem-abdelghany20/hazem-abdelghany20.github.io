---
import type { CollectionEntry } from 'astro:content';
import { seriesDef, type SeriesKey } from '../lib/series';

interface Props {
  series: SeriesKey;
  prev?: CollectionEntry<'essays'>;
  next?: CollectionEntry<'essays'>;
}
const { series, prev, next } = Astro.props;
const s = seriesDef(series);
---

<nav class="series-nav">
  <div class="series-nav-side">
    {prev && (
      <a href={`/essays/${prev.id}/`}>
        <span class="series-nav-dir"><span class="arrow" aria-hidden="true">‹</span> {prev.data.partLabel}</span>
        <span class="series-nav-title">{prev.data.title}</span>
      </a>
    )}
  </div>
  <a class="series-nav-home" href={s.href}>All parts</a>
  <div class="series-nav-side series-nav-right">
    {next && (
      <a href={`/essays/${next.id}/`}>
        <span class="series-nav-dir">{next.data.partLabel} <span class="arrow" aria-hidden="true">›</span></span>
        <span class="series-nav-title">{next.data.title}</span>
      </a>
    )}
  </div>
</nav>

<style>
  .series-nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 24px;
    align-items: start;
    max-width: 680px;
    margin: 72px auto 0 auto;
    padding-top: 26px;
    border-top: 1px solid var(--line);
  }
  .series-nav-side a { display: flex; flex-direction: column; gap: 5px; }
  .series-nav-right { text-align: end; }
  .series-nav-dir {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: var(--muted);
  }
  .series-nav-side a:hover .series-nav-dir { color: var(--accent); }
  .series-nav-title { font-size: 16px; color: var(--ink); line-height: 1.35; }
  .series-nav-side a:hover .series-nav-title { color: var(--accent); }
  .series-nav-home {
    display: inline-block;
    padding: 10px 0;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
    padding-top: 2px;
  }
  .series-nav-home:hover { color: var(--accent); }
  @media (max-width: 640px) {
    .series-nav { grid-template-columns: 1fr; gap: 20px; }
    .series-nav-right { text-align: start; }
    .series-nav-home { order: 3; }
  }
</style>
