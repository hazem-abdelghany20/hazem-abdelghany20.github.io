---
import { THREADS } from '../lib/threads';
import { liveLinks } from '../lib/site';

interface Props { lang?: 'en' | 'ar' }
const { lang = 'en' } = Astro.props;
const isAr = lang === 'ar';
const links = liveLinks();
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-top">
    <nav class="footer-threads" aria-label={isAr ? 'الخيوط' : 'Threads'}>
      <span class="kicker">{isAr ? 'الخيوط' : 'Threads'}</span>
      <ul>
        {THREADS.map((t) => (
          <li>
            <a href={`/threads/${t.key}/`}>
              {isAr ? (
                <>{t.ar} <span class="en" dir="ltr" lang="en">{t.en}</span></>
              ) : (
                <>{t.en} <span class="ar" dir="rtl" lang="ar">{t.ar}</span></>
              )}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <nav class="footer-site" aria-label={isAr ? 'الموقع' : 'Site'}>
      <span class="kicker">{isAr ? 'الموقع' : 'Site'}</span>
      <ul>
        <li><a href="/books/">{isAr ? 'الكتب' : 'Books'}</a></li>
        <li><a href="/essays/">{isAr ? 'المقالات' : 'Articles'}</a></li>
        <li><a href={isAr ? '/ar/about/' : '/about/'}>{isAr ? 'عنّي' : 'About'}</a></li>
        <li><a href="/rss.xml">{isAr ? 'الخلاصة' : 'RSS'}</a></li>
      </ul>
    </nav>

    {links.length > 0 && (
      <nav class="footer-elsewhere" aria-label={isAr ? 'أماكن تانية' : 'Elsewhere'}>
        <span class="kicker">{isAr ? 'أماكن تانية' : 'Elsewhere'}</span>
        <ul>
          {links.map((l) => (
            <li>
              <a href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </div>

  <div class="footer-base">
    <div style="display: flex; align-items: baseline; gap: 10px;">
      <span class="meta">{isAr ? 'القاهرة، مصر' : 'Cairo, Egypt'}</span>
      <span class="dot">·</span>
      <span dir={isAr ? 'ltr' : 'rtl'} lang={isAr ? 'en' : 'ar'} style="font-size: 15px; color: var(--muted);">{isAr ? 'Cairo' : 'القاهرة'}</span>
    </div>
    <span class="meta">© {year} {isAr ? 'حازم عبدالغني' : 'Hazem Abdelghany'}</span>
  </div>
</footer>

<style>
  .footer-top {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 40px;
    border-top: 1px solid var(--line);
    padding: 44px 0 36px 0;
  }
  .footer-top nav { display: flex; flex-direction: column; gap: 16px; }
  .footer-top ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }
  /* inline-block + padding so each row is a real tap target, not a 16px line */
  .footer-top a { display: inline-block; padding: 9px 0; font-size: 16px; color: var(--ink-2); }
  .footer-top a:hover { color: var(--accent); }
  .footer-top .ar { color: var(--faint); font-size: 15px; }
  .footer-top .en { color: var(--faint); font-family: var(--font-en); font-size: 13px; margin-inline-start: 3px; }
  :global(html[dir='rtl']) .kicker { letter-spacing: 0; text-transform: none; font-size: 16px; font-weight: 700; }
  .footer-base {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 12px;
    border-top: 1px solid var(--line);
    padding: 22px 0 44px 0;
  }
  @media (max-width: 680px) {
    .footer-top { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 30px; }
  }
</style>
